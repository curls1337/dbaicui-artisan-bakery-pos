# ==============================================================================
# D'Bai Cui Artisan Bakery & Cake Management System - Environment Template
# Salin file ini menjadi `.env` dan isi nilai secret sebelum menjalankan server.
# JANGAN PERNAH commit file `.env` asli ke repositori Git.
# ==============================================================================

# --- 1. Server & Aplikasi ---
NODE_ENV=development
PORT=3100
APP_NAME="D'Bai Cui Artisan Bakery System"
APP_URL=http://localhost:3100
STAGING_BASE_URL=https://webui.5nod.com/staging/saint-sejarah-firaun/
CORS_ORIGIN=http://localhost:3100,http://localhost:5173,https://webui.5nod.com
LOG_LEVEL=info

# --- 2. Database (PostgreSQL Production / SQLite Local Staging) ---
# Pilihan DB_CLIENT: "sqlite" (demo/dev) atau "postgres" (production)
DB_CLIENT=sqlite
SQLITE_PATH=./database/dbaicui_dev.sqlite
DATABASE_URL=postgresql://dbaicui_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/dbaicui_bakery?sslmode=disable
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- 3. Autentikasi, JWT & Terminal Quick PIN ---
JWT_SECRET=CHANGE_ME_MIN_64_HEX_CHARACTERS_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS_SECRET
JWT_REFRESH_EXPIRES_IN=7d
PIN_SESSION_EXPIRES_IN=12h
SESSION_COOKIE_SECRET=CHANGE_ME_COOKIE_SIGNING_SECRET
BCRYPT_SALT_ROUNDS=12

# --- 4. Rate Limiting & Keamanan ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=15

# --- 5. Integrasi Pembayaran QRIS & Payment Gateway ---
PAYMENT_PROVIDER=midtrans_or_xendit_qris
QRIS_MERCHANT_ID=ID_MERCHANT_DBAICUI_CHANGE_ME
QRIS_MERCHANT_NAME="D'Bai Cui Artisan Bakery"
QRIS_API_BASE_URL=https://api.sandbox.payment-provider.example/v2
QRIS_API_KEY=CHANGE_ME_QRIS_SERVER_KEY
QRIS_WEBHOOK_SECRET=CHANGE_ME_QRIS_WEBHOOK_HMAC_SECRET
QRIS_CALLBACK_URL=https://api.dbaicui.example/api/webhooks/qris

# --- 6. Integrasi WhatsApp Gateway (Notifikasi Pre-Order & Struk Digital) ---
WA_GATEWAY_PROVIDER=fonnte_or_wablas_or_meta
WA_GATEWAY_BASE_URL=https://api.wa-gateway.example/send
WA_GATEWAY_API_KEY=CHANGE_ME_WA_GATEWAY_TOKEN
WA_SENDER_NUMBER=6281100000000
WA_WEBHOOK_SECRET=CHANGE_ME_WA_WEBHOOK_SECRET

# --- 7. Email SMTP (Invoice & Reset Password) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@dbaicui.example
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM="D'Bai Cui Patisserie <noreply@dbaicui.example>"

# --- 8. Penyimpanan Media (Foto Produk & Referensi Custom Cake) ---
STORAGE_PROVIDER=local_or_s3
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=dbaicui-cake-assets
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_ACCESS_KEY=CHANGE_ME_STORAGE_KEY
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_SECRET
UPLOAD_MAX_SIZE_MB=5

# --- 9. Konfigurasi POS, Pajak & Printer Thermal ---
POS_DEFAULT_PRINTER_WIDTH=58mm
POS_TAX_RATE_PERCENT=10
POS_SERVICE_CHARGE_PERCENT=0
POS_LOW_STOCK_ALERT_HOUR=07:00

# --- 10. Mobile App Build Config (Referensi Client) ---
MOBILE_API_BASE_URL=https://api.dbaicui.example
MOBILE_APP_ORG=com.devcurl.dbaicui
